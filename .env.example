# DDevops 部署配置示例
# 用法：复制本文件为 .env 并填入真实值

# ---- SQLite 数据库路径（默认 ./jenkins.db，可改为绝对路径）----
SQLITE_DB_PATH=jenkins.db

# ---- 主 Jenkins ----
JENKINS_BASE_URL=
JENKINS_USER=
JENKINS_TOKEN=

# ---- 第二 Jenkins（可选，不需要可留空）----
JENKINS2_BASE_URL=
JENKINS2_USER=
JENKINS2_TOKEN=

# ---- 钉钉机器人（Stream 模式，ClientID / ClientSecret）----
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=

# ---- 初始管理员（仅首次启动 seed；之后请在 Web 后台改密，改密会踢旧会话）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- 端口 ----
WEB_PORT=8081
HEALTH_PORT=8080
